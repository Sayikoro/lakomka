# ============================================================
#  Лакомка — статика Next.js + PHP API на обычном Apache-хостинге
#  Положить в КОРЕНЬ сайта (рядом с папками /backend, /_next, /uploads)
#  Требования: Apache с mod_rewrite и разрешённым .htaccess (AllowOverride All)
# ============================================================

DirectoryIndex index.html
Options -Indexes

RewriteEngine On

# ------------------------------------------------------------
# 0. AI-FIREWALL: ИИ-краулеры и автономные агенты — 403.
#    Классические поисковики (Googlebot, Bingbot, Yandex) не тронуты.
# ------------------------------------------------------------
RewriteCond %{HTTP_USER_AGENT} (GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-Web|anthropic-ai|CCBot|Google-Extended|Bytespider|PerplexityBot|Perplexity-User|YouBot|Amazonbot|Applebot-Extended|Diffbot|ImagesiftBot|Meta-ExternalAgent|FacebookBot|cohere-ai) [NC]
RewriteRule ^ - [F,L]

# Внутренняя инструкция деплоя — только для владельца
RewriteRule ^README-DEPLOY\.md$ - [F,L]

# ------------------------------------------------------------
# 1. Защита: наружу отдаётся ТОЛЬКО backend/public/index.php.
#    База (storage), исходники (src), конфиги — закрыты.
# ------------------------------------------------------------
RewriteCond %{REQUEST_URI} ^/backend/
RewriteCond %{REQUEST_URI} !^/backend/public/index\.php$
RewriteRule ^ - [F,L]

# ------------------------------------------------------------
# 1a. Медиа — ВСЕГДА прямая статика, мимо PHP.
#     Если отдавать видео через PHP, параллельные загрузки
#     (превью в галерее, каталог) исчерпывают лимит процессов
#     хостинга → 503 на .mov/.mp4 и подвисание всей админки.
#     Здесь — гарантированный pass-through: Apache отдаёт файлы
#     сам, Range-запросы (перемотка видео) работают нативно.
# ------------------------------------------------------------
AddType video/mp4 .mp4 .m4v
AddType video/webm .webm
AddType video/quicktime .mov .qt
AddType image/webp .webp
AddType image/avif .avif
RewriteRule ^uploads(/.*)?$ - [L]
# /exports больше не публичен (аудит Task 131): экспортные ZIP переехали
# в backend/storage/exports, закрытый правилом «/backend/ → 403» выше.

# ------------------------------------------------------------
# 2. /api/* → PHP-приложение (фронтконтроллер читает REQUEST_URI,
#    поэтому видит настоящий адрес /api/... даже после rewrite)
# ------------------------------------------------------------
RewriteRule ^api(/.*)?$ backend/public/index.php [QSA,L]

# ------------------------------------------------------------
# 3. Красивые адреса: экспорт Next.js кладёт страницы в папки
#    с index.html (/catalog/ и т.д.). Для надёжности — фолбэк
#    на .html, если файл запрошен без слэша.
# ------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ------------------------------------------------------------
# 4. Старые WordPress-адреса → новые страницы (301)
# ------------------------------------------------------------
Redirect 301 /shop /catalog/
Redirect 301 /checkout-2 /checkout/
Redirect 301 /my-account /
Redirect 301 /privacy-policy /privacy/
RewriteRule ^wp-login\.php$ / [R=301,L]
RewriteRule ^wp-json(/.*)?$ / [R=301,L]
RewriteRule ^wp-admin(/.*)?$ / [R=301,L]
RewriteRule ^comments/feed(/.*)?$ / [R=301,L]
RewriteRule ^feed(/.*)?$ / [R=301,L]

# ------------------------------------------------------------
# 5. Страница 404 (сгенерирована Next.js)
# ------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------
# 6. Сжатие и кэш (модули есть не везде — обёрнуто в IfModule)
#    6a. Security-заголовки (кликджекинг, MIME-sniffing, утечки)
# ------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# SVG (в т.ч. снежинки из админки): запрет сценариев при прямом открытии
<FilesMatch "\.svg$">
  <IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
    Header always set X-Content-Type-Options "nosniff"
  </IfModule>
</FilesMatch>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
  # RSC-полезные нагрузки Next (static export кладёт их в *.txt) — до 5-6x сжатия
  AddOutputFilterByType DEFLATE text/plain
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  # Хэшированные ассеты Next.js — кэш на год. ВАЖНО: Apache на современных
  # версиях отдаёт .js как text/javascript (а не application/javascript),
  # без обеих строк кэша у чанков не будет (Lighthouse: «эффективный
  # период хранения кеша»).
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  # Медиа товаров — месяц
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType video/webm "access plus 1 month"
  ExpiresByType video/quicktime "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  # Шрифты (не хэшированы, но меняются крайне редко)
  ExpiresByType font/otf "access plus 1 month"
  ExpiresByType font/ttf "access plus 1 month"
  ExpiresByType font/woff "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
  ExpiresByType application/font-woff "access plus 1 month"
  ExpiresByType application/font-woff2 "access plus 1 month"
  ExpiresByType application/x-font-ttf "access plus 1 month"
  ExpiresByType application/x-font-otf "access plus 1 month"
  # HTML и JSON API — без кэша
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Страховка для хостингов без mod_expires: тот же кэш через mod_headers
# (проверено на проде: mod_headers активен, mod_expires может отсутствовать).
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpe?g|png|gif|svg|ico|avif|mp4|m4v|webm|mov|otf|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML — всегда проверять свежесть (иначе после обновления сайта браузер
  # держит старый HTML со ссылками на удалённые чанки)
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------
# 7. HTTPS: раскомментируйте после выпуска сертификата
#    (обычно сертификат выпускается в панели хостинга автоматически)
# ------------------------------------------------------------
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

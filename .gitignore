# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example



# backend: секреты, БД и рантайм-файлы
backend/config.local.php
backend/UPDATE_ROOT
backend/storage/*
!backend/storage/database.sqlite
backend/storage/database.sqlite-*
backend/public/uploads-test/
/public/exports/

# тестовый стенд обновлений (песочница)
.update-staging/
.update-tmp-*/

# next.js env
.env.local
.env*.local

# статическая сборка и деплой-артефакты
.next-static/
.deploy-package/
out/
download/
.admin-export-stash/

# деплой-архив (121МБ — GitHub не примет файл >100МБ)
/deploy/

# служебные артефакты песочницы и отладки (не часть сайта)
.admin-page.html
.initial_snapshot.json
.git-stub/
.png-backup/
.png-repair/
Caddyfile
.deploy-package-update/
